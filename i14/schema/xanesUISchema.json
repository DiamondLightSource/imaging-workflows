{
  "type": "VerticalLayout",
  "options": {
    "formWidth": "80%"
  },
  "elements": [
    {
      "type": "Control",
      "scope": "#/properties/multiScan",
      "options": {
        "elementLabelProp": "scanRange",
        "detail": {
          "type": "VerticalLayout",
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/multiScan/items",
              "options": {
                "useScanRangeControl": true
              }
            }
           ]
        }
      }
    },
    {
      "type": "HorizontalLayout",
      "elements": [
        {
          "type": "Control",
          "scope": "#/properties/method"
        },
        {
          "type": "Control",
          "scope": "#/properties/brute",
          "rule": {
            "effect": "SHOW",
            "condition": {
              "scope": "#/properties/method",
              "schema": {
                "const": "mutual"
              }
            }
          }
        },
        {
          "type": "Control",
          "scope": "#/properties/max_fractional_shift",
          "rule": {
            "effect": "SHOW",
            "condition": {
              "type": "AND",
              "conditions": [
                {
                  "scope": "#/properties/method",
                  "schema": { "const": "mutual" }
                },
                {
                  "scope": "#/properties/brute",
                  "schema": { "const": true }
                }
              ]
            }
          }
        }
      ]
    },
    {
      "type": "HorizontalLayout",
      "elements": [
        {
          "type": "Control",
          "scope": "#/properties/edgeElement"
        },
        {
          "type": "Control",
          "scope": "#/properties/edgeTransition"
        }
      ]
    },
    {
      "type": "HorizontalLayout",
      "elements": [
        {
          "type": "Control",
          "scope": "#/properties/elementToAlign"
        },
        {
          "type": "Control",
          "scope": "#/properties/transitionToAlign"
        }
      ]
    },
    {
      "type": "Control",
      "scope": "#/properties/normalise"
    },
    {
      "type": "Control",
      "scope": "#/properties/outputFolder"
    }
  ]
}
