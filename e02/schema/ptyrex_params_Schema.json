{
  "type": "object",
    "description": "basic inputs for ptyrex submission",
    "properties": {
        "scanId": {
            "default": null,
            "maximum": 10000000000,
            "minimum": 0,
            "title": "Scan number",
            "type": "integer"
        },
        "proj_number": {
            "default": null,
            "maximum": 10000000,
            "minimum": 0,
            "title": "Proj Number",
            "type": "integer"
        },
        "prefix": {
            "type": "string",
            "maximum": 64,
            "minimum": 0,
            "title": "Reconstruction output file prefix"
        },
        "iterations": {
            "type": "integer",
            "default": 100,
            "minimum": 1,
            "maximum": 10000,
            "title": "The number of ptyrex iterations to perform"
        },
        "objectupdate": {
            "type": "float",
            "default": 1,
            "minimum": 0,
            "maximum": 1,
            "title": "Object update rate (alpha)"
        },
        "probeupdate": {
            "type": "float",
            "default": 1,
            "minimum": 0,
            "maximum": 1,
            "title": "Probe update rate (beta)"
        },
        "modes": {
            "type": "integer",
            "default": 1,
            "minimum": 0,
            "maximum": 20,
            "title": "Probe modes"
        },
        "upsample": {
            "type": "integer",
            "maximum": 8,
            "minimum": 1,
            "default": 1,
            "title": "The degree of upsampling applied to the collected data"
        },
        "bitdepth": {
            "title": "The degree of upsampling applied to the collected data",
            "type": "integer",
            "maximum": 32,
            "minimum": 8,
            "default": 16
        },
        "probepath": {
            "type": "string",
            "maximum": 128,
            "minimum": 0,
            "title": "Path to a probe reconstruction (must be within the same visit)",
            "default": ""
        },
        "probeloadflag": {
            "type": "integer",
            "maximum": 1,
            "minimum": 0,
            "default": 0,
            "title": "Path to a probe reconstruction (must be within the same visit)"
        },
        "outdir": {
            "type": "string",
            "maximum": 128,
            "minimum": 1,
            "title": "Relative output path within the visit"
        },
        "nprocs": {
            "default": 4,
            "maximum": 4,
            "minimum": 0,
            "title": "Nprocs",
            "type": "integer"
        },
        "memory": {
            "type": "string",
            "pattern": "^[0-9]+[GMK]i$",
            "default": "32Gi"
        }
        
    },
    "title": "RexSubmission"
}
    
